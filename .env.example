# Concordance configuration. Copy to .env (git-ignored) and fill in.
# The cron wrappers load it; for a manual run, export it into your shell first
# (see the README). Values must not contain spaces around '=' or after commas.

# --- Calibre-Web Automated -----------------------------------------------------
CWA_URL=http://localhost:8083
CWA_USER=
# Profile -> "App passwords for OPDS / KOReader Sync"
CWA_APP_PASSWORD=

# --- Audiobookshelf ------------------------------------------------------------
ABS_URL=http://localhost:13378
# Settings -> API Keys
ABS_API_KEY=

# --- Calibre library (read-only) -----------------------------------------------
CALIBRE_ROOT=/path/to/calibre-library
# CALIBRE_DB defaults to $CALIBRE_ROOT/metadata.db

# ABS reports audio file paths as its own container sees them. Map that prefix to
# the same directory on this host: <path in ABS>=<path on host>
ABS_AUDIO_ROOT_MAP=/audiobooks=/path/to/audiobooks

# --- Writes --------------------------------------------------------------------
# Calibre ids that --apply may write. Start with a test book, add real ones later.
CONCORDANCE_WRITE_ALLOWLIST=
# CONCORDANCE_WRITE_TIERS=aligned,interpolated,finished
# CONCORDANCE_REWIND_SECONDS=150
# CONCORDANCE_CWA_PERCENT_MARGIN=2.0

# --- Alignment -----------------------------------------------------------------
# CONCORDANCE_ALIGNER_IMAGE=concordance-aligner:latest
# CONCORDANCE_ALIGNER_MEMORY=4g
# Keep the budget ~10% under the container memory limit
# CONCORDANCE_ALIGN_BUDGET_MB=3600
# CONCORDANCE_ALIGN_MIN_FREE_MB=5000
# CONCORDANCE_ALIGN_LOOKAHEAD=2
# CONCORDANCE_ALIGN_CHUNK_SECONDS=1500
# CONCORDANCE_ALIGN_END_MARGIN=300
# CONCORDANCE_ALIGN_BATCH_SIZE=1
# CONCORDANCE_ALIGNER_THREADS=8
# Docker's default is 1024; raise it (e.g. 26192) to outrank other containers
# CONCORDANCE_ALIGNER_CPU_SHARES=1024
# CONCORDANCE_MIN_ALIGN_SCORE=-1.0
# No new alignment job after this time (unset: no deadline)
# CONCORDANCE_ALIGN_DEADLINE=06:00
# CONCORDANCE_ALIGN_MEMORY_WAIT=60
# CONCORDANCE_STATE_DIR=/home/you/.cache/concordance
# Interpreter for the cron wrappers, if you installed into a virtualenv
# CONCORDANCE_PYTHON=/path/to/venv/bin/python

# --- Testing (contrib/sandbox) -------------------------------------------------
# CONCORDANCE_TEST_CASES=
# CONCORDANCE_SANDBOX_PROFILE=contrib/sandbox/profiles/my-book.sh
# CWA_APP_DB=/path/to/cwa/config/app.db
